{
  "name": "hunting-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @hunting/shared typecheck && pnpm --filter hunting-app check && pnpm exec tsc --noEmit -p worker/tsconfig.json",
    "build": "pnpm -r --filter hunting-app build",
    "simulator": "pnpm --filter @hunting/bot-simulator start"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
